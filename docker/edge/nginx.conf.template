upstream cathode_backend {
    server backend:8080;
    keepalive 32;
}

limit_req_zone $binary_remote_addr zone=api_limit:10m rate=$EDGE_RATE;
limit_conn_zone $binary_remote_addr zone=addr:10m;

server {
    listen 8080;
    server_tokens off;
    client_max_body_size $EDGE_MAX_BODY;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-XSS-Protection "0" always;

    location / {
        limit_req zone=api_limit burst=$EDGE_BURST nodelay;
        limit_conn addr 100;

        proxy_pass http://cathode_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout $EDGE_CONNECT_TIMEOUT;
        proxy_read_timeout $EDGE_READ_TIMEOUT;
        proxy_send_timeout $EDGE_SEND_TIMEOUT;
    }
}
