# Start of .gitignore
# ---------------------

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Node.js / Next.js ---
node_modules/
.next/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- System ---
.DS_Store
Thumbs.db
.env
.env.local
.env.*.local
*.pem
*.key

# --- Data ---
# Ignore all data by default...
data/
# ...but explicitly allow predictions needed for the app
!data/predictions/

# --- Artifacts ---
# Allow models (small enough for git ~7MB)
# artifacts/  <-- Removed this ignore
# But ignore other large artifacts if they exist later
artifacts/checkpoints/

# --- Logs ---
logs/
*.log
wandb/

# --- Project Specific ---
# ALIGNN large format data
# ALIGNN large format data
data/alignn_format/

# --- GCP / Training ---
.venv-training/
checkpoints/
outputs/
build_log*.txt

