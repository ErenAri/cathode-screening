# Start of .gitignore
# ---------------------

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Node.js / Next.js ---
node_modules/
.next/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- System ---
.DS_Store
Thumbs.db
nul

# --- Secrets & Credentials ---
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*.credentials

# --- Data ---
# Ignore all data by default...
data/
# ...but explicitly allow predictions needed for the app
!data/predictions/

# --- Artifacts ---
# Keep metadata (ensemble_meta.json, config.yaml, metrics.json, conformal_params.json)
# but exclude heavy model checkpoints (22MB each)
artifacts/checkpoints/
artifacts/**/*.pt
artifacts/**/*.pth

# --- Logs ---
logs/
*.log
wandb/

# --- Project Specific ---
# ALIGNN large format data
# ALIGNN large format data
data/alignn_format/

# --- DFT / QE ---
reports/dft_qe_*/pseudos/
reports/dft_qe_*/SSSP_*.tar.gz
reports/dft_qe_*/**/pw.out
reports/dft_qe_*/**/pw.err
reports/dft_qe_*/**/*.save/
reports/dft_qe_*/**/out/
reports/dft_qe_*/run_all_qe_parallel.log

# --- GCP / Training ---
.venv-training/
checkpoints/
outputs/
build_log*.txt

