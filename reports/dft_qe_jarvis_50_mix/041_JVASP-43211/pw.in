&CONTROL
  calculation = 'relax',
  restart_mode = 'from_scratch',
  outdir = './out',
  pseudo_dir = '../pseudos',
  verbosity = 'high',
/
&SYSTEM
  ibrav = 0,
  nat = 4,
  ntyp = 3,
  ecutwfc = 100.0,
  ecutrho = 1080.0,
  occupations = 'smearing',
  smearing = 'mp',
  degauss = 0.0200,
  nspin = 2,
  starting_magnetization(1) = 0.00,
  starting_magnetization(2) = 0.60,
  starting_magnetization(3) = 0.00,
/
&ELECTRONS
  conv_thr = 1.0d-6,
  mixing_beta = 0.7,
/
&IONS
  ion_dynamics = 'bfgs',
/

